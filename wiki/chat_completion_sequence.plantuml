@startuml chat_completion_sequence
skinparam backgroundColor white
skinparam BoxPadding 10

actor User
participant "Axum API\n(/chat/completions)" as API
participant "Rig AgentTeam" as Team
participant "Planner Agent" as Planner
participant "Searcher Agent" as Searcher
database "Tools\n(Jira/R2R)" as Tools
participant "QA Agent" as QA

User -> API : POST [AgentInput]
activate API

API -> Team : .generate(input)
activate Team

Team -> Planner : plan(messages)
activate Planner
Planner --> Team : Steps and Tool Calls
deactivate Planner

Team -> Searcher : execute(tools)
activate Searcher
Searcher -> Tools : Query
Tools --> Searcher : Context/Tickets
Searcher --> Team : Gathered Facts
deactivate Searcher

Team -> QA : finalize(context)
activate QA
QA --> Team : Refined Response
deactivate QA

Team --> API : Stream/Result
deactivate Team

API --> User : [AgentOutput]
deactivate API

@enduml
