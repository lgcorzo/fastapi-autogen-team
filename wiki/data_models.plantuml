@startuml data_models
set namespaceSeparator none

struct "AppState" as AppState {
  +agent_team: AgentTeam
  +jira_url: String
  +jira_user: String
  +jira_token: String
  +litellm_url: String
  +litellm_key: String
  +r2r_url: String
}

struct "Message" as Message {
  +role: String
  +content: String
}

struct "AgentInput" as AgentInput {
  +model: String
  +messages: Vec<Message>
  +temperature: Option<f32>
  +top_p: Option<f32>
  +stream: Option<bool>
}

struct "AgentOutput" as AgentOutput {
  +id: String
  +object: String
  +created: i64
  +model: String
  +choices: Vec<Choice>
  +usage: Usage
}

AgentInput "1" *-- "many" Message : contains
AppState "1" *-- "1" AgentTeam : manages

@enduml
